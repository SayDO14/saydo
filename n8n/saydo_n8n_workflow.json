{
  "name": "SayDo - Send approved emails",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "saydo-sync",
        "options": {}
      },
      "id": "n1",
      "name": "Supabase Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "saydo-sync"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "s3",
                    "leftValue": "={{ $json.body.table }}",
                    "rightValue": "emails",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "id": "s4",
                    "leftValue": "={{ $json.body.record.status }}",
                    "rightValue": "approved",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "emails (approved)"
            }
          ]
        },
        "options": {}
      },
      "id": "n2",
      "name": "Which table?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.body.record.to_email }}",
        "subject": "={{ $json.body.record.subject }}",
        "emailType": "text",
        "message": "={{ $json.body.record.body }}\n\n—\nSent by {{ $json.body.record.sender_name || 'a SayDo user' }}{{ $json.body.record.sender_email ? ' (' + $json.body.record.sender_email + ')' : '' }} via SayDo",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ ($json.body.record.sender_name || 'SayDo') + ' via SayDo' }}",
          "replyTo": "={{ $json.body.record.sender_email || '' }}"
        }
      },
      "id": "n9",
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        460,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "emails",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Supabase Webhook').item.json.body.record.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "sent"
            },
            {
              "fieldId": "gmail_message_id",
              "fieldValue": "={{ $json.id }}"
            },
            {
              "fieldId": "sent_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "id": "n10",
      "name": "Mark email sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        700,
        260
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "emails",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Supabase Webhook').item.json.body.record.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "failed"
            },
            {
              "fieldId": "error_message",
              "fieldValue": "={{ String($json.error?.message ?? $json.error) }}"
            }
          ]
        }
      },
      "id": "n11",
      "name": "Mark email failed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        700,
        380
      ]
    }
  ],
  "connections": {
    "Supabase Webhook": {
      "main": [
        [
          {
            "node": "Which table?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Which table?": {
      "main": [
        [
          {
            "node": "Send Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Gmail": {
      "main": [
        [
          {
            "node": "Mark email sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark email failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}