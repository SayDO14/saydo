      "id": "n2",
      "name": "Which table?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $json.body.record;\nconst start = new Date(r.start_at);\nconst end = r.end_at ? new Date(r.end_at) : new Date(start.getTime() + 60 * 60 * 1000);\nconst people = (r.related_people || []).map(p => typeof p === 'string' ? p : (p.name || '')).filter(Boolean);\nconst parts = [];\nif (r.description) parts.push(r.description);\nif (people.length) parts.push('With: ' + people.join(', '));\nreturn [{ json: {\n  id: r.id,\n  summary: r.title,\n  start: start.toISOString(),\n  end: end.toISOString(),\n  timezone: r.timezone || 'Africa/Algiers',\n  location: r.location || '',\n  description: parts.join('\\n')\n}}];"
      },
      "id": "n3",
      "name": "Prepare event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        80
      ]
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "list",
          "cachedResultName": "primary"
        },
        "start": "={{ $json.start }}",
        "end": "={{ $json.end }}",
        "additionalFields": {
          "summary": "={{ $json.summary }}",
          "description": "={{ $json.description }}",
          "location": "={{ $json.location }}",
          "timezone": "={{ $json.timezone }}"
        }
      },
