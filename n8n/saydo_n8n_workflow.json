    },
    {
      "parameters": {
        "jsCode": "const r = $json.body.record;\nconst people = (r.related_people || []).map(p => typeof p === 'string' ? p : (p.name || '')).filter(Boolean);\nconst parts = [];\nif (r.notes) parts.push(r.notes);\nif (people.length) parts.push('With: ' + people.join(', '));\nreturn [{ json: {\n  id: r.id,\n  title: r.title,\n  notes: parts.join('\\n'),\n  due: r.due_at ? new Date(r.due_at).toISOString() : ''\n}}];"
      },
      "id": "n8",
      "name": "Prepare task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
